# Kling AI Direct API (klingai.com)
# Get your keys from: https://klingai.com/developer (API Management section)
KLING_ACCESS_KEY_ID=your_access_key_id_here
KLING_ACCESS_KEY_SECRET=your_secret_key_here

# Model configuration (optional)
# Available models: kling-v1, kling-v1-5, kling-v1-6, kling-v2
# Available modes:  std (standard), pro (requires premium plan)
KLING_MODEL=kling-v1-6
KLING_MODE=std
